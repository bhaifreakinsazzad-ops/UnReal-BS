# Copy this file to .env.local or configure the same names in your deploy
# target's environment settings. Fill in real values there, never here.
# .env* is gitignored by default.

# --- Auth (NextAuth v5 credentials login, see auth.ts) ---------------------
# Required. Login is rejected if either is missing; there is no fallback account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Required in production. Secret used to sign session JWTs.
# Generate one with: npx auth secret
AUTH_SECRET=
NEXT_PUBLIC_APP_URL=https://www.unreal-bs.shop

# Only needed if your deploy target cannot infer the canonical URL itself.
# auth.ts sets trustHost: true, so this is usually not required on Vercel.
# NEXTAUTH_URL=https://your-domain.example.com

# --- GoHighLevel private integration (see lib/ghl/client.ts) ----------------
# Required. Private Integration token for the GHL location this app manages.
GHL_PRIVATE_TOKEN=

# Required. The GHL sub-account location ID this app reads and writes.
GHL_LOCATION_ID=

# --- Database (Supabase) — see supabase/migrations/0001_unreal_bs_core.sql -----
# Required for real user accounts and persisted Udhar Khata / opportunity data.
# Without these, the app falls back to the single ADMIN_EMAIL/PASSWORD login
# and Udhar Khata/opportunities won't persist across devices.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI Subscriptions providers (see lib/ai-providers/) --------------------
# Shared, pooled keys — NOT customer-specific. Usage/spend is tracked
# per-customer internally via unreal_bs_ai_usage_ledger, not via provider-side
# per-key limits. Leave a key unset to disable that provider — chat requests
# routed to it will fail gracefully with a clear error, other providers keep
# working.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
# Moonshot/Kimi. NOTE: this is a SEPARATE account/key at platform.moonshot.cn
# — despite Moonshot's API being OpenAI-request-format-compatible, an
# OPENAI_API_KEY will not authenticate against Moonshot's servers.
MOONSHOT_API_KEY=
# OpenRouter — router to many upstream models, OpenAI-request-format-compatible.
OPENROUTER_API_KEY=
# Cohere Chat API v2 — NOT OpenAI-request-format-compatible.
COHERE_API_KEY=
# Cerebras Inference — OpenAI-request-format-compatible.
CEREBRAS_API_KEY=
# Cloudflare Workers AI — needs BOTH values (account id + API token); unlike
# the other providers above, a single key is not enough to authenticate.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Hugging Face Inference Providers router — OpenAI-chat-completions-compatible.
HUGGINGFACE_API_KEY=
# Tavily — a web SEARCH tool used to ground chat answers, NOT a chat/completion
# provider. Not part of the AIProvider registry in lib/ai-providers/index.ts.
# Leave unset to hide the "search the web" toggle entirely.
TAVILY_API_KEY=

# --- Virtual card credential encryption (see lib/crypto/card-credentials.ts) --
# Required for the virtual-card assign/reveal flow. 32-byte key, base64
# encoded. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CARD_CREDENTIAL_ENC_KEY=

# --- UNREAL BS founding-pilot MVP flags -----------------------------------
NEXT_PUBLIC_UNREAL_BS_PUBLIC_URL=/unreal-bs
HOOOPLAAA_OPPORTUNITY_SOURCE=seed
HOOOPLAAA_STARTER_CREDIT_LIMIT=5000
UNREAL_BS_FOUNDING_ACTIVATION_BDT=4999
UNREAL_BS_MONTHLY_MEMBERSHIP_BDT=6999

# ─── Meta (Facebook / Instagram) Ads ────────────────────────────────────────
# Ads work WITHOUT these: campaigns are fulfilled in 'managed' mode, where the
# operator sets them up in Meta Ads Manager. These are only needed to publish
# directly through the Marketing API, which additionally requires Meta App
# Review approval of `ads_management`, Advanced Access, and Business
# Verification. See lib/meta/client.ts.
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
# Set to 'true' ONLY after App Review has approved ads_management with Advanced
# Access. Until then direct publishing stays off and campaigns route to the
# managed queue, which is the honest behaviour.
META_ADS_MANAGEMENT_APPROVED=false

# Consent-gated measurement. The Pixel ID is safe for the browser; the CAPI
# token is server-only. Keep both unset until Meta Test Events is ready.
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v25.0
META_TEST_EVENT_CODE=
NEXT_PUBLIC_CONSENT_VERSION=2026-08-05

# Cloudflare Turnstile is used only on /apply. Keep disabled until both keys
# are configured and the public form is verified.
TURNSTILE_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# CSP starts report-only. Enforce only after preview violation review confirms
# Next.js, Puter, Meta, Turnstile, Monaco, video embeds and storage sources.
CSP_ENFORCE=false

# ─── Digital products checkout (see lib/commerce/payment-provider.ts) ───────
# The numbers buyers send money to. Launch products are platform-owned, so the
# full confirmed price is platform revenue and seller payout remains zero.
#
# Set at least one, or the checkout page has nowhere to tell a buyer to pay.
# Leave the others blank to hide them.
PLATFORM_BKASH_NUMBER=
PLATFORM_NAGAD_NUMBER=
PLATFORM_ROCKET_NUMBER=

# Dark-launch controls. Public/seller flags are false by default and must stay
# false until the corresponding release gates pass.
COMMERCE_ENABLED=false
STORE_PUBLIC_ENABLED=false
MARKETPLACE_SELLERS_ENABLED=false
COMMERCE_CANARY_EMAILS=

# Set to 'true' only once a real gateway (SSLCommerz / aamarPay) is wired up
# behind the PaymentProvider interface. While false, checkout tells the buyer
# honestly that a person confirms their payment, which is what actually
# happens.
PAYMENT_GATEWAY_ENABLED=false
