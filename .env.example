# Copy this file to .env.local or configure the same names in your deploy
# target's environment settings. Fill in real values there, never here.
# .env* is gitignored by default.

# --- Auth (NextAuth v5 credentials login, see auth.ts) ---------------------
# Required. Login is rejected if either is missing; there is no fallback account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Required in production. Secret used to sign session JWTs.
# Generate one with: npx auth secret
AUTH_SECRET=

# Only needed if your deploy target cannot infer the canonical URL itself.
# auth.ts sets trustHost: true, so this is usually not required on Vercel.
# NEXTAUTH_URL=https://your-domain.example.com

# --- GoHighLevel private integration (see lib/ghl/client.ts) ----------------
# Required. Private Integration token for the GHL location this app manages.
GHL_PRIVATE_TOKEN=

# Required. The GHL sub-account location ID this app reads and writes.
GHL_LOCATION_ID=

# --- Database (Supabase) — see supabase/migrations/0001_unreal_bs_core.sql -----
# Required for real user accounts and persisted Udhar Khata / opportunity data.
# Without these, the app falls back to the single ADMIN_EMAIL/PASSWORD login
# and Udhar Khata/opportunities won't persist across devices.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI Subscriptions providers (see lib/ai-providers/) --------------------
# Shared, pooled keys — NOT customer-specific. Usage/spend is tracked
# per-customer internally via unreal_bs_ai_usage_ledger, not via provider-side
# per-key limits. Leave a key unset to disable that provider — chat requests
# routed to it will fail gracefully with a clear error, other providers keep
# working.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
# Moonshot/Kimi. NOTE: this is a SEPARATE account/key at platform.moonshot.cn
# — despite Moonshot's API being OpenAI-request-format-compatible, an
# OPENAI_API_KEY will not authenticate against Moonshot's servers.
MOONSHOT_API_KEY=

# --- UNREAL BS founding-pilot MVP flags -----------------------------------
NEXT_PUBLIC_UNREAL_BS_PUBLIC_URL=/unreal-bs
HOOOPLAAA_OPPORTUNITY_SOURCE=seed
HOOOPLAAA_STARTER_CREDIT_LIMIT=5000
UNREAL_BS_FOUNDING_ACTIVATION_BDT=4999
UNREAL_BS_MONTHLY_MEMBERSHIP_BDT=6999
